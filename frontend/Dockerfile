# Образ для локальной разработки: исходники монтируются снаружи,
# внутрь кладётся только Node.
FROM node:22-alpine

WORKDIR /app

EXPOSE 5173

# --host обязателен: иначе Vite слушает только 127.0.0.1 внутри контейнера
# и снаружи порт окажется недоступен.
CMD ["sh", "-c", "npm install --no-audit --no-fund && npm run dev -- --host 0.0.0.0"]
